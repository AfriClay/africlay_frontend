{
  "expo": {
    "name": "AfriClay",
    "slug": "africlay",
    "scheme": "africlay",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/africlay-app-icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.africlay.appfront",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/africlay-app-icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/africlay-brand-v1.png"
    },
    "plugins": [
      "expo-image",
      "expo-font",
      "expo-secure-store",
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#17532F",
          "image": "./assets/africlay-brand-v1.png",
          "imageWidth": 220,
          "resizeMode": "contain"
        }
      ],
      "expo-dev-client",
      [
        "expo-web-browser",
        {
          "experimentalLauncherActivity": false
        }
      ]
    ]
  }
}
