# Include /api in the base URL.
# Web: http://localhost:8000/api
# Android emulator: http://10.0.2.2:8000/api
# Physical device: http://<computer-lan-ip>:8000/api
# Native development rewrites this loopback host to Metro's LAN host when the
# app is opened over Wi-Fi. Production builds must use the deployed HTTPS API.
EXPO_PUBLIC_API_URL=http://localhost:8000/api
